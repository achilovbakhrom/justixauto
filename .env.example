# Local development only. Copy to .env (git-ignored) and adjust.
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://justixauto:change-me-local-only@127.0.0.1:55432/justixauto?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
# Plain-HTTP local development only; keep true (default) everywhere else.
COOKIE_SECURE=false
# Extra origins allowed to send state-changing requests (e.g. Vite dev servers).
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176
# Encrypts two-factor secrets. Generate your own: openssl rand -base64 32
# Changing or losing it disables every enrolled authenticator.
MFA_KEY=REPLACE_WITH_openssl_rand_base64_32
# Built React apps (npm run build:apps) served by the API; empty = API only.
WEB_DIR=web/apps
# Uploaded documents: local (DOCUMENTS_DIR) for development, s3 in production.
FILE_STORAGE=local
DOCUMENTS_DIR=var/documents
# FILE_STORAGE=s3 settings (credentials from the standard AWS chain):
# S3_BUCKET=justixauto-documents
# S3_REGION=eu-central-1
# S3_PREFIX=documents/
# S3_SSE=AES256
# For MinIO or another S3-compatible store:
# S3_ENDPOINT=http://127.0.0.1:59000
# S3_FORCE_PATH_STYLE=true
