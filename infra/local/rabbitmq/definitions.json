{
  "rabbit_version": "4.3.5",
  "rabbitmq_version": "4.3.5",
  "product_name": "JustixAuto local broker",
  "product_version": "1",
  "users": [
    { "name": "svc_identity", "password_hash": "", "hashing_algorithm": "rabbit_password_hashing_sha256", "tags": [] },
    { "name": "svc_inventory", "password_hash": "", "hashing_algorithm": "rabbit_password_hashing_sha256", "tags": [] },
    { "name": "svc_commerce", "password_hash": "", "hashing_algorithm": "rabbit_password_hashing_sha256", "tags": [] },
    { "name": "svc_retail", "password_hash": "", "hashing_algorithm": "rabbit_password_hashing_sha256", "tags": [] },
