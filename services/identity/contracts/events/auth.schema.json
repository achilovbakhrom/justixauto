{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.justixauto.invalid/identity/events/auth.schema.json",
  "title": "identity.auth.security-changed.v1",
  "description": "Closed safe Identity authentication metadata event. It cannot reconstruct or authorize credentials, factors, sessions, challenges or recovery material. External delivery requires a separately approved recipient plan and admission.",
  "type": "object",
  "properties": {
    "eventId": {"$ref": "#/$defs/id"},
    "eventType": {"type": "string", "const": "identity.auth.security-changed.v1"},
    "schemaVersion": {"type": "integer", "const": 1},
    "aggregateType": {"type": "string", "const": "auth-security"},
    "aggregateId": {"$ref": "#/$defs/id"},
    "aggregateVersion": {"$ref": "#/$defs/positiveRevision"},
    "integrationSequence": {"$ref": "#/$defs/positiveRevision"},
    "companyId": {"type": "null", "const": null},
    "occurredAt": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"},
    "actor": {"$ref": "#/$defs/actor"},
    "correlationId": {"$ref": "#/$defs/id"},
    "causationId": {"$ref": "#/$defs/id"},
    "operationId": {"$ref": "#/$defs/id"},
    "data": {"$ref": "#/$defs/securityChangedData"}
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "integrationSequence",
    "companyId",
    "occurredAt",
    "actor",
    "correlationId",
    "causationId",
    "operationId",
    "data"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {"const": "00000000-0000-0000-0000-000000000000"}
    },
    "positiveRevision": {
      "type": "string",
      "pattern": "^([1-9][0-9]{0,17}|[1-8][0-9]{18}|9[01][0-9]{17}|92[01][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[01][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7])$"
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {"type": "string", "enum": ["user", "service", "system"]},
        "id": {"$ref": "#/$defs/id"}
      },
      "required": ["kind", "id"],
      "additionalProperties": false
    },
    "securityChangedData": {
      "type": "object",
      "properties": {
        "userId": {"$ref": "#/$defs/id"},
        "securityRevision": {"$ref": "#/$defs/positiveRevision"},
        "change": {
          "type": "string",
          "enum": [
            "credential-created",
            "credential-replaced",
            "mfa-enrolled",
            "sessions-revoked",
            "bootstrap-enrollment-started"
          ]
        }
      },
      "required": ["userId", "securityRevision", "change"],
      "additionalProperties": false,
      "description": "userId must equal aggregateId and securityRevision must equal committed private subject state; both are enforced at the owner semantic boundary."
    }
  }
}
