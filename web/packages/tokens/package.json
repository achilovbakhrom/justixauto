{
  "name": "@justixauto/tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": { "./tokens.css": "./src/tokens.css" },
  "sideEffects": ["**/*.css"],
  "files": ["src/tokens.css"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node -e \"const fs=require('node:fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('src/tokens.css','dist/tokens.css')\""
  }
}
